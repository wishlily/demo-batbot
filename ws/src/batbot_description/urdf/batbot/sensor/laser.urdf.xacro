<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find batbot_description)/urdf/batbot/common_inertia.xacro" />

  <xacro:macro name="laser_xacro" params="xyz">
    <link name="laser_bracket_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.0375 0.0377 0.0207" />
        </geometry>
        <material name="green" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.0375 0.0377 0.0207" />
        </geometry>
        <material name="green" />
      </collision>
      <xacro:box_inertia m="0.01" x="0.0375" y="0.0377" z="0.0207" />
    </link>

    <joint name="laser_bracket_joint" type="fixed">
      <parent link="bracket_link" />
      <child link="laser_bracket_link" />
      <origin xyz="${xyz}" />
    </joint>

    <link name="laser_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder length="0.0123" radius="0.0185" />
        </geometry>
        <material name="green" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder length="0.0123" radius="0.0185" />
        </geometry>
        <material name="green" />
      </collision>
      <xacro:cylinder_inertia m="0.03" r="0.0185" h="0.0123" />
    </link>

    <joint name="laser_joint" type="fixed">
      <parent link="laser_bracket_link" />
      <child link="laser_link" />
      <origin xyz="0 0 0.0165" />
    </joint>

  </xacro:macro>

</robot>